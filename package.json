{
  "name": "salesforce-qa-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable AI-driven QA agent for Salesforce orgs (Chrome extension + local Playwright server).",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "npm run start -w @sfqa/server",
    "dev": "npm run dev -w @sfqa/server",
    "build:extension": "npm run build -w @sfqa/extension",
    "connect": "npm run connect -w @sfqa/server --",
    "connections": "npm run connections -w @sfqa/server --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0"
  }
}
