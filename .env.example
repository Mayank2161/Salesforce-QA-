# Copy to .env and fill in. Never commit .env.

# Claude API key (used by the local server only; never sent to the extension)
ANTHROPIC_API_KEY=

# Shared secret the Chrome extension must send to the local server
AGENT_TOKEN=change-me

# Local server port (server binds to 127.0.0.1 only)
PORT=4317

# Browser for test runs: "chrome" (installed Google Chrome) or "chromium" (needs: npx playwright install chromium)
BROWSER_CHANNEL=chrome

# Set to false to watch test runs in a visible browser window
HEADLESS=true

# Hybrid execution: Claude may batch actions it has already decided on (run_steps). false = one Claude decision per browser action
HYBRID_EXECUTION=true

# Where project folders (Projects/<project>/<org>/...) are kept. Default: QA-Workspace in this folder
# QA_WORKSPACE_DIR=D:\QA-Workspace
